{
  "name": "balaji-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:worker": "node scripts/check-release-source.mjs check && npm test && npm run typecheck && CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && node scripts/prepare-worker-env.mjs && node scripts/check-worker-artifacts.mjs && node scripts/check-release-source.mjs record",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "node scripts/check-release-source.mjs deploy && node scripts/check-worker-config.mjs && node scripts/check-worker-artifacts.mjs && opennextjs-cloudflare deploy",
    "check:worker": "node scripts/check-worker-config.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@supabase/supabase-js": "latest",
    "clsx": "latest",
    "exceljs": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
