# Runtime mode. Omit APP_MODE for a local non-production demo; use live only with the settings below.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3001

# Local demo persistence (ignored by git)
DEMO_DATABASE_PATH=.data/demo.sqlite

# Live PostgreSQL / Supabase server connection
DATABASE_URL=
DATABASE_SSL=verify
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_AUTH_USER_ID=
CRON_SECRET=
